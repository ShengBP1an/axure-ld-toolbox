# 依赖与构建产物
node_modules/
dist/
dist-ssr/

# 端到端验证产物（每次运行重新生成）
artifacts/
.playwright-cli/
test-results/
playwright-report/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 用户数据：草图与工程文件不应进版本库（隐私）
*.ldproj.json
*.svg
!fixtures/*.svg

# 临时文件
*.tmp
*.tsbuildinfo
tmp-*.txt
s1.yaml
step*.png

# 开发期落盘目录（保存 SVG / 工程的输出）
exports/
